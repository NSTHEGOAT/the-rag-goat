"""Talks to a local Ollama server. No external APIs.

Two jobs:
  1. answer() — answer a question grounded in retrieved chunks, citing [n]
  2. quiz()   — generate multiple-choice questions strictly from chunks (JSON)
"""
from __future__ import annotations

import json
import re

import httpx

from . import config


class OllamaError(RuntimeError):
    pass


async def _chat(system: str, user: str, force_json: bool = False) -> str:
    payload = {
        "model": config.OLLAMA_MODEL,
        "stream": False,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        "options": {"temperature": 0.2},
    }
    if force_json:
        payload["format"] = "json"
    try:
        async with httpx.AsyncClient(timeout=config.OLLAMA_TIMEOUT) as client:
            r = await client.post(f"{config.OLLAMA_URL}/api/chat", json=payload)
            r.raise_for_status()
    except httpx.ConnectError as e:
        raise OllamaError(
            f"Cannot reach Ollama at {config.OLLAMA_URL}. "
            f"Is it running? Try: ollama serve"
        ) from e
    except httpx.HTTPStatusError as e:
        detail = e.response.text[:300]
        raise OllamaError(
            f"Ollama returned {e.response.status_code}: {detail}. "
            f"Have you pulled the model? Try: ollama pull {config.OLLAMA_MODEL}"
        ) from e
    return r.json()["message"]["content"]


def _format_context(hits: list[dict]) -> str:
    blocks = []
    for i, h in enumerate(hits, start=1):
        loc = f"{h['source']}" + (f", page {h['page']}" if h["page"] else "")
        blocks.append(f"[{i}] ({loc})\n{h['snippet']}")
    return "\n\n---\n\n".join(blocks)


ANSWER_SYSTEM = (
    "You are a retrieval-grounded assistant. Answer ONLY using the numbered "
    "context passages provided. After every claim, cite the passage(s) that "
    "support it using square brackets, e.g. [1] or [2][3]. If the context "
    "does not contain the answer, say so plainly and do not invent anything. "
    "Be concise."
)


async def answer(question: str, hits: list[dict]) -> str:
    context = _format_context(hits)
    user = f"Context passages:\n\n{context}\n\nQuestion: {question}"
    return await _chat(ANSWER_SYSTEM, user)


QUIZ_SYSTEM = (
    "You generate quiz questions STRICTLY from the provided passages. Every "
    "question must be answerable from its passage alone — never use outside "
    "knowledge. Respond with JSON only, no prose, in this exact shape:\n"
    '{"questions": [{"question": str, "options": [str, str, str, str], '
    '"answer_index": int, "explanation": str, "ref": int}]}\n'
    "ref is the [n] number of the passage the question is based on. "
    "answer_index is 0-based. Wrong options must be plausible but clearly "
    "incorrect according to the passage."
)


def _extract_json(text: str) -> dict:
    """Small local models sometimes wrap JSON in fences or chatter."""
    text = re.sub(r"^```(?:json)?|```$", "", text.strip(), flags=re.MULTILINE).strip()
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", text, flags=re.DOTALL)
        if not match:
            raise OllamaError("Model did not return valid JSON for the quiz.")
        return json.loads(match.group(0))


async def quiz(hits: list[dict], num_questions: int) -> list[dict]:
    context = _format_context(hits)
    user = (
        f"Passages:\n\n{context}\n\n"
        f"Write exactly {num_questions} multiple-choice questions (4 options each)."
    )
    raw = await _chat(QUIZ_SYSTEM, user, force_json=True)
    data = _extract_json(raw)
    questions = data.get("questions", data if isinstance(data, list) else [])

    cleaned = []
    for q in questions[:num_questions]:
        try:
            ref = int(q.get("ref", 1))
            hit = hits[ref - 1] if 1 <= ref <= len(hits) else hits[0]
            options = [str(o) for o in q["options"]][:4]
            idx = int(q["answer_index"])
            if not (0 <= idx < len(options)):
                continue
            cleaned.append({
                "question": str(q["question"]),
                "options": options,
                "answer_index": idx,
                "explanation": str(q.get("explanation", "")),
                "chunk_id": hit["chunk_id"],
                "snippet": hit["snippet"],
            })
        except (KeyError, TypeError, ValueError, IndexError):
            continue
    if not cleaned:
        raise OllamaError("Could not parse any valid quiz questions from the model.")
    return cleaned
