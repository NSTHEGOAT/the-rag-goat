from fastapi import FastAPI, HTTPException, UploadFile
from fastapi.middleware.cors import CORSMiddleware

from . import config, ingest, llm, store
from .schemas import (
    ChatRequest, ChatResponse, Citation,
    DocumentInfo, IngestResult,
    QuizRequest, QuizResponse, QuizQuestion,
)

app = FastAPI(title="Local RAG", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000", "http://127.0.0.1:3000"],
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/health")
async def health():
    col = store.get_collection()
    return {
        "status": "ok",
        "chunks": col.count(),
        "embed_model": config.EMBED_MODEL,
        "llm_model": config.OLLAMA_MODEL,
        "ollama_url": config.OLLAMA_URL,
    }


@app.post("/ingest", response_model=list[IngestResult])
async def ingest_files(files: list[UploadFile]):
    results = []
    for f in files:
        data = await f.read()
        try:
            records = list(ingest.build_records(f.filename, data))
        except ValueError as e:
            raise HTTPException(status_code=400, detail=str(e))
        if not records:
            raise HTTPException(
                status_code=422,
                detail=f"No extractable text in {f.filename} (scanned PDF? Run OCR first).",
            )
        added = store.upsert_chunks(records)
        # keep the original on disk so the corpus is inspectable
        (config.DATA_DIR / f.filename).write_bytes(data)
        results.append(IngestResult(source=f.filename, chunks_added=added))
    return results


@app.get("/documents", response_model=list[DocumentInfo])
async def documents():
    return store.list_documents()


@app.delete("/documents/{source}")
async def delete_document(source: str):
    store.delete_document(source)
    path = config.DATA_DIR / source
    if path.exists():
        path.unlink()
    return {"deleted": source}


@app.post("/chat", response_model=ChatResponse)
async def chat(req: ChatRequest):
    hits = store.query(req.question, req.top_k)
    if not hits:
        raise HTTPException(
            status_code=409,
            detail="No documents ingested yet. Upload a PDF or Markdown file first.",
        )
    try:
        answer = await llm.answer(req.question, hits)
    except llm.OllamaError as e:
        raise HTTPException(status_code=502, detail=str(e))

    citations = [
        Citation(ref=i, chunk_id=h["chunk_id"], source=h["source"],
                 page=h["page"], snippet=h["snippet"], distance=h["distance"])
        for i, h in enumerate(hits, start=1)
    ]
    return ChatResponse(answer=answer, citations=citations, model=config.OLLAMA_MODEL)


@app.post("/quiz", response_model=QuizResponse)
async def quiz(req: QuizRequest):
    if req.topic and req.topic.strip():
        hits = store.query(req.topic.strip(), req.top_k)
    else:
        hits = store.sample_chunks(req.top_k)
    if not hits:
        raise HTTPException(
            status_code=409,
            detail="No documents ingested yet. Upload a PDF or Markdown file first.",
        )
    try:
        questions = await llm.quiz(hits, req.num_questions)
    except llm.OllamaError as e:
        raise HTTPException(status_code=502, detail=str(e))
    return QuizResponse(
        questions=[QuizQuestion(**q) for q in questions],
        model=config.OLLAMA_MODEL,
    )
